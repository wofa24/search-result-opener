{
  "manifest_version": 3,
  "name": "搜索结果批量打开器",
  "version": "3.7.1",
  "description": "一键打开Bing/Google搜索结果的前N个链接，支持侧边栏导航和标签页分组",
  "permissions": [
    "tabs",
    "tabGroups",
    "sidePanel",
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://www.bing.com/*",
    "https://www.google.com/*",
    "https://cn.bing.com/*",
    "https://www.google.com.hk/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "quick-open-results": {
      "suggested_key": {
        "default": "Alt+Shift+O",
        "mac": "Alt+Shift+O"
      },
      "description": "在搜索页快速打开前N个结果（N在插件高级设置中配置，默认10）"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bing.com/*",
        "https://cn.bing.com/*"
      ],
      "js": ["content-scripts/common.js", "content-scripts/bing.js"]
    },
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.com.hk/*"
      ],
      "js": ["content-scripts/common.js", "content-scripts/google.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
